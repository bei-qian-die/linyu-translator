{
  "name": "linyu-translator",
  "version": "1.18.0",
  "description": "中文 -> 淋语 翻译器（Electron + SQLite / Capacitor + sql.js）",
  "main": "src/main/main.js",
  "author": "qiuzh",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/prepare-desktop.mjs && electron .",
    "check": "node scripts/check.js",
    "test": "node test/core.test.js && node test/db.test.js && node test/service.test.js && node test/weapp.test.js",
    "test:core": "node test/core.test.js",
    "test:db": "node test/db.test.js",
    "e2e": "node scripts/e2e-dev.js && node scripts/e2e-data.js",
    "dist": "node scripts/prepare-desktop.mjs && electron-builder --win",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:open": "npm run mobile:build && cap sync android && cap open android",
    "mobile:sync": "cap sync android",
    "mobile:run": "cap run android",
    "weapp:sync": "node scripts/build-weapp-data.mjs",
    "test:weapp": "node test/weapp.test.js",
    "verify:weapp": "node test/weapp.test.js",
    "lint": "eslint src scripts test miniprogram",
    "web:build": "node scripts/build-web.mjs",
    "lint:fix": "eslint src scripts test miniprogram --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/**/*.js\" \"test/**/*.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "test:service": "node test/service.test.js",
    "prepare-desktop": "node scripts/prepare-desktop.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/screen-orientation": "^6.0.3",
    "@capacitor/share": "^6.0.4",
    "scrypt-js": "^3.0.1",
    "sql.js": "^1.13.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "electron": "^33.4.5",
    "electron-builder": "^25.1.8",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.qiuzh.linyu-translator",
    "productName": "淋语翻译器",
    "directories": {
      "output": "release"
    },
    "files": [
      "!node_modules/**/*",
      "src/core/**/*",
      "src/main/**/*",
      "src/renderer/**/*",
      "src/mobile/**/*",
      "build/icon.png",
      "README.md",
      "node_modules/scrypt-js/scrypt.js",
      "node_modules/sql.js/package.json",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/vue/dist/vue.global.prod.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
