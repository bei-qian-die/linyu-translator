{
  "name": "linyu-translator",
  "version": "1.12.1",
  "description": "中文 -> 淋语 翻译器（Electron + SQLite）",
  "main": "src/main/main.js",
  "author": "qiuzh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node test/core.test.js && node test/db.test.js",
    "test:core": "node test/core.test.js",
    "test:db": "node test/db.test.js",
    "e2e": "node scripts/e2e-dev.js && node scripts/e2e-data.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "electron": "^33.4.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.qiuzh.linyu-translator",
    "productName": "淋语翻译器",
    "directories": {
      "output": "release"
    },
    "files": [
      "!node_modules/**/*",
      "src/core/**/*",
      "src/main/**/*",
      "src/renderer/**/*",
      "build/icon.png",
      "node_modules/sql.js/package.json",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/vue/dist/vue.global.prod.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
