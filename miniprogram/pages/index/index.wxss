.live {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 20rpx;
  padding: 14rpx 2rpx 14rpx 18rpx;
  color: var(--faint);
  font-size: 17rpx;
  letter-spacing: 0.06em;
}

.live-dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 10rpx;
  border: 1rpx solid var(--faint);
  border-radius: 50%;
  background: transparent;
}

.live.on .live-dot {
  border-color: var(--accent);
  background: var(--accent);
}

.live-state {
  margin-left: 8rpx;
}

.live.on .live-state {
  color: var(--accent);
}

.headline {
  margin: 8rpx 0 72rpx;
  font-size: 84rpx;
  font-weight: 600;
  line-height: 1.28;
  letter-spacing: 0.005em;
  color: var(--ink);
}

.hl-line {
  display: block;
}

.field {
  margin-bottom: 44rpx;
  border-bottom: 2rpx solid var(--line-strong);
}

.field-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
  margin-bottom: 2rpx;
  font-size: 17rpx;
  letter-spacing: 0.12em;
  color: var(--faint);
  text-transform: uppercase;
}

.field-tools {
  display: flex;
  align-items: center;
}

.field-label {
  letter-spacing: 0.14em;
}

.field-op {
  margin-left: 12rpx;
  padding: 16rpx 8rpx;
  color: var(--muted);
  font-size: 19rpx;
  letter-spacing: 0.04em;
}

.field-count {
  flex: none;
  font-size: 17rpx;
  letter-spacing: 0.06em;
  color: var(--faint);
}

.input-area {
  width: 100%;
  height: 190rpx;
  padding: 0 0 20rpx;
  box-sizing: border-box;
  background: transparent;
  color: var(--ink);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.5;
}

.input-placeholder {
  color: var(--faint);
  font-size: 32rpx;
  font-weight: 400;
  letter-spacing: 0.01em;
}

.samples {
  width: 100%;
  margin-bottom: 56rpx;
  white-space: nowrap;
}

.samples-inner {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
}

.samples-label {
  flex: none;
  margin-right: 14rpx;
  font-size: 17rpx;
  letter-spacing: 0.12em;
  color: var(--faint);
}

.sample {
  display: inline-flex;
  align-items: center;
  flex: none;
  min-height: 72rpx;
  margin-right: 12rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1.4;
}

.translate-btn {
  border: 0;
  border-radius: 28rpx;
  background: var(--cta-bg);
  color: var(--cta-fg);
}

.cta-heart {
  margin-left: 16rpx;
  font-size: 26rpx;
  line-height: 1;
}

.cta-hover {
  opacity: 0.82;
}

/* 微信原生禁用态会覆盖背景与文字色，这里显式压回透明描边 */
.translate-btn[disabled] {
  border: 2rpx solid var(--line) !important;
  border-radius: 28rpx !important;
  background: transparent !important;
  color: var(--faint) !important;
  opacity: 1 !important;
  box-shadow: none !important;
  letter-spacing: 0.12em;
}

.result {
  margin-top: 72rpx;
  padding-top: 40rpx;
  border-top: 2rpx solid var(--line);
}

.result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.result-toggles {
  display: flex;
  align-items: center;
  flex: none;
}

.result-label {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  color: var(--ink);
}

.result-text {
  display: block;
  min-height: 190rpx;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.7;
  letter-spacing: 0.01em;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-all;
}

.result-text.is-hint {
  min-height: 150rpx;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 1.7;
  letter-spacing: 0.02em;
  color: var(--faint);
}

.result-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
}

.result-note {
  font-size: 17rpx;
  letter-spacing: 0.04em;
  color: var(--faint);
}

.result-actions {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 24rpx;
}

.result-act {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  margin-left: 30rpx;
  padding: 0 2rpx;
  border: 0;
  border-bottom: 2rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 1;
  letter-spacing: 0.04em;
}

.result-act.act-hover {
  border-color: var(--accent);
  color: var(--accent);
}

.local-note {
  margin-top: 56rpx;
  padding: 32rpx 0 24rpx;
  text-align: center;
  font-size: 17rpx;
  line-height: 1.8;
  letter-spacing: 0.08em;
  color: var(--faint);
}
