.page-sub {
  margin-bottom: 28rpx;
}

.tabs {
  display: flex;
  align-items: stretch;
  margin: 2rpx 0 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.tab {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 84rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: var(--muted);
}

.tab-label {
  font-size: 21rpx;
  font-weight: 400;
  letter-spacing: 0.02em;
}

.tab-count {
  font-size: 16rpx;
  letter-spacing: 0.02em;
  color: var(--faint);
}

.tab.on {
  color: var(--ink);
}

.tab.on .tab-label {
  font-weight: 600;
}

.tab.on .tab-count {
  color: var(--accent);
}

.tab.on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -2rpx;
  height: 4rpx;
  background: var(--accent);
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  align-items: center;
  padding: 4rpx 0 16rpx;
  white-space: nowrap;
}

.w-no {
  flex: none;
  width: 36rpx;
  margin-right: 16rpx;
  font-family: Consolas, "Courier New", monospace;
  font-size: 16rpx;
  line-height: 1.8;
  letter-spacing: 0.04em;
  color: var(--faint);
}

.word-right {
  display: flex;
  align-items: baseline;
  min-width: 0;
  margin-left: auto;
  padding-left: 20rpx;
}

.word-alias,
.word-sense,
.word-meta {
  padding-left: 52rpx;
}

.hero-card {
  display: flex;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.hero-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 88rpx;
  height: 88rpx;
  margin-right: 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  color: var(--accent);
  font-size: 32rpx;
  font-weight: 600;
}

.hero-body {
  flex: 1;
  min-width: 0;
}

.hero-name {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.h-name {
  margin-right: 12rpx;
  font-size: 31rpx;
  font-weight: 600;
  color: var(--ink);
}

.h-rank {
  font-size: 18rpx;
  letter-spacing: 0.04em;
  color: var(--accent);
}

.hero-alias {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--faint);
}

.hero-intro {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--muted);
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hero-more {
  margin-top: 8rpx;
  font-size: 20rpx;
  letter-spacing: 0.03em;
  color: var(--accent);
}

.list-foot {
  margin-top: 4rpx;
}

/* 骨架屏（C10）：lore 解析期间占位 */
.skeleton {
  display: flex;
  flex-direction: column;
  padding-top: 12rpx;
}

.sk-row {
  padding: 26rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.sk-line {
  height: 26rpx;
  margin: 14rpx 0;
  border-radius: 8rpx;
  background: var(--soft);
  animation: sk-pulse 1.2s ease-in-out infinite;
}

.sk-line.w40 {
  width: 40%;
}

.sk-line.w70 {
  width: 70%;
}

@keyframes sk-pulse {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sk-line {
    animation: none;
  }
}
