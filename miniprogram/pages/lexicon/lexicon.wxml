<view class="page theme-{{theme}} page-custom-nav" style="padding-top:{{navTop}}px;">
  <nav-bar status-bar="{{statusBar}}" nav-bar-h="{{navBarH}}" />

  <view class="eyebrow">
    <view class="eyebrow-left"><text>LEXICON</text><text class="eyebrow-mark">/</text><text>词库</text></view>
    <text class="eyebrow-right">可溯源</text>
  </view>

  <view class="page-title">查一个词，<view class="pt-line">看它的来路<text class="pt-dot">。</text></view></view>
  <view class="page-sub">共 {{counts.words}} 词条 · {{counts.rules}} 句式 · {{counts.cards}} 词卡 · {{counts.quotes}} 名言 · {{counts.heroes}} 人物</view>

  <view class="search-box">
    <view class="search-ico"></view>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="{{placeholder}}"
      placeholder-class="placeholder"
      confirm-type="search"
      bindinput="onSearch"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <view class="tabs">
    <view
      class="tab {{tab === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      <text class="tab-label">{{item.label}}</text>
      <text class="tab-count">{{item.count}}</text>
    </view>
  </view>

  <!-- 顶部跳页条：页码输入框直接改数字 + 跳转，不用一页一页按「加载更多」 -->
  <view wx:if="{{ready && pages > 1}}" class="pg-bar">
    <text class="pg-total">第 {{page}} / {{pages}} 页 · 共 {{matched}} 条</text>
    <view class="pg-jump">
      <text class="pg-label">跳至</text>
      <input
        class="pg-input"
        type="number"
        value="{{jumpVal}}"
        confirm-type="go"
        bindinput="onJumpInput"
        bindconfirm="doJump"
      />
      <text class="pg-label">页</text>
      <view class="pg-go" bindtap="doJump">跳转</view>
    </view>
  </view>

  <view wx:if="{{!ready}}" class="skeleton">
    <view class="sk-row" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this">
      <view class="sk-line w40"></view>
      <view class="sk-line w70"></view>
    </view>
  </view>

  <block wx:if="{{ready}}">
  <view wx:if="{{tab === 'words'}}" class="word-list">
    <view class="word-card" wx:for="{{shown}}" wx:key="zh">
      <view class="word-main">
        <text class="w-no">{{item.no}}</text>
        <text class="word-zh">
          <block wx:if="{{item.zhParts}}">
            <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.zhParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
          </block>
          <block wx:else>{{item.zh}}</block>
        </text>
        <view class="word-right">
          <text class="word-arrow">→</text>
          <text class="word-ly">
            <block wx:if="{{item.lyParts}}">
              <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.lyParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
            </block>
            <block wx:else>{{item.linyu}}</block>
          </text>
        </view>
      </view>
      <view wx:if="{{item.alias}}" class="word-alias">别名：{{item.alias}}</view>
      <view wx:if="{{item.sense}}" class="word-sense">{{item.sense}}</view>
      <view wx:if="{{item.pop || item.source}}" class="word-meta">
        <text wx:if="{{item.pop}}" class="h-tag">{{item.pop}}流行</text>
        <text wx:if="{{item.source}}" class="word-src">{{item.source}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{tab === 'rules'}}" class="rule-list">
    <view class="rule-card" wx:for="{{shown}}" wx:key="id">
      <view class="rule-head">
        <text class="rule-id">#{{item.id}}</text>
        <text wx:if="{{item.note}}" class="h-tag">{{item.note}}</text>
        <text wx:if="{{item.scene}}" class="h-tag">{{item.scene}}</text>
      </view>
      <view class="rule-row">
        <text class="rule-label">匹配</text>
        <text class="rule-pattern">
          <block wx:if="{{item.patternParts}}">
            <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.patternParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
          </block>
          <block wx:else>{{item.pattern}}</block>
        </text>
      </view>
      <view class="rule-row">
        <text class="rule-label accent">替换</text>
        <text class="rule-template">
          <block wx:if="{{item.templateParts}}">
            <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.templateParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
          </block>
          <block wx:else>{{item.template}}</block>
        </text>
      </view>
      <view wx:if="{{item.examples}}" class="rule-example">例：{{item.examples}}</view>
      <view wx:if="{{item.src}}" class="lore-source">{{item.src}}</view>
    </view>
  </view>

  <empty-state
    wx:if="{{!shown.length}}"
    title="{{emptyTitle}}"
    sub="{{emptySub}}"
    show-reset="{{keyword}}"
    bindreset="clearSearch"
  />

  <!-- 底部翻页条：上一页 / 页码 / 下一页 + 第二个跳页框 -->
  <view wx:if="{{shown.length && pages > 1}}" class="pg-bar pg-bar-foot">
    <view class="pg-nav">
      <view class="pg-btn {{page <= 1 ? 'off' : ''}}" data-delta="-1" bindtap="stepPage">‹ 上一页</view>
      <text class="pg-total">第 {{page}} / {{pages}} 页</text>
      <view class="pg-btn {{page >= pages ? 'off' : ''}}" data-delta="1" bindtap="stepPage">下一页 ›</view>
    </view>
    <view class="pg-jump">
      <text class="pg-label">跳至</text>
      <input
        class="pg-input"
        type="number"
        value="{{jumpVal}}"
        confirm-type="go"
        bindinput="onJumpInput"
        bindconfirm="doJump"
      />
      <text class="pg-label">页</text>
      <view class="pg-go" bindtap="doJump">跳转</view>
    </view>
  </view>
  <view wx:elif="{{shown.length}}" class="pg-end">共 {{matched}} 条</view>
  </block>

  <view class="tip">内容整理自公开语料，仅供娱乐 · 只读浏览</view>
</view>
