.hero-top {
  display: flex;
  align-items: center;
  padding: 8rpx 0 28rpx;
}

.hero-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 120rpx;
  height: 120rpx;
  margin-right: 24rpx;
  overflow: hidden;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  color: var(--accent);
  font-size: 44rpx;
  font-weight: 600;
}

/* 首字垫在底下：图片没加载出来时自然回落成文字方块，不会裂图 */
.hero-initial {
  line-height: 1;
}

.hero-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--soft);
}

.hero-head {
  flex: 1;
  min-width: 0;
}

.hero-name {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.hero-name-text {
  margin-right: 14rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.25;
  color: var(--ink);
  word-break: break-all;
}

.hero-rank {
  font-size: 18rpx;
  letter-spacing: 0.04em;
  color: var(--accent);
}

.hero-alias {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--faint);
  word-break: break-all;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.stats-bar {
  padding: 0 0 4rpx;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.8;
  letter-spacing: 0.04em;
  color: var(--faint);
}

.section-label {
  margin: 36rpx 0 12rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}

.intro-text,
.baike-text {
  font-size: 25rpx;
  line-height: 1.8;
  color: var(--ink);
  word-break: break-all;
}

.baike-text {
  color: var(--muted);
}

.work-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.work-chip {
  margin: 0 12rpx 12rpx 0;
  padding: 10rpx 22rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.link-list {
  display: flex;
  flex-direction: column;
}

.link-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.link-body {
  flex: 1;
  min-width: 0;
  margin-right: 18rpx;
}

.link-label {
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.6;
  color: var(--ink);
  word-break: break-all;
}

.link-url {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.6;
  color: var(--faint);
  word-break: break-all;
}

.link-copy {
  flex: none;
  padding: 24rpx 0 24rpx 24rpx;
  color: var(--accent);
  font-size: 19rpx;
  letter-spacing: 0.03em;
}

.back-bar {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}

.back-btn {
  padding: 0 40rpx;
}
