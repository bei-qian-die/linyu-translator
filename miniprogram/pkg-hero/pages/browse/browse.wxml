<view class="page theme-{{theme}}">
  <view class="eyebrow">
    <view class="eyebrow-left"><text>ARCHIVE</text><text class="eyebrow-mark">/</text><text>浏览</text></view>
    <text class="eyebrow-right">可溯源</text>
  </view>

  <view class="page-sub">共 {{counts.cards}} 词卡 · {{counts.quotes}} 名言 · {{counts.heroes}} 人物</view>

  <view class="search-box">
    <view class="search-ico"></view>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="{{placeholder}}"
      placeholder-class="placeholder"
      confirm-type="search"
      bindinput="onSearch"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <view class="tabs">
    <view
      class="tab {{tab === item.key ? 'on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      <text class="tab-label">{{item.label}}</text>
      <text class="tab-count">{{item.count}}</text>
    </view>
  </view>

  <scroll-view wx:if="{{tab === 'cards'}}" class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view
        class="chip {{cardType === item.key ? 'on' : ''}}"
        wx:for="{{cardFilters}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="changeCardType"
      >{{item.label}}<text class="chip-count">{{item.count}}</text></view>
    </view>
  </scroll-view>

  <block wx:if="{{tab === 'heroes'}}">
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <view
          class="chip {{heroGroup === item.key ? 'on' : ''}}"
          wx:for="{{heroGroups}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="changeHeroGroup"
        >{{item.label}}<text class="chip-count">{{item.count}}</text></view>
      </view>
    </scroll-view>
    <scroll-view wx:if="{{heroGroup === 'game' && heroZones.length}}" class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-row">
        <view class="chip {{heroZone === '' ? 'on' : ''}}" data-key="all" bindtap="changeHeroZone">全部分区</view>
        <view
          class="chip {{heroZone === item.key ? 'on' : ''}}"
          wx:for="{{heroZones}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="changeHeroZone"
        >{{item.label}}<text class="chip-count">{{item.count}}</text></view>
      </view>
    </scroll-view>
  </block>

  <view wx:if="{{!ready}}" class="skeleton">
    <view class="sk-row" wx:for="{{[1, 2, 3, 4, 5]}}" wx:key="*this">
      <view class="sk-line w40"></view>
      <view class="sk-line w70"></view>
    </view>
  </view>

  <block wx:if="{{ready}}">
  <view wx:if="{{tab === 'cards'}}" class="lore-list">
    <view class="lore-card" wx:for="{{shown}}" wx:key="id">
      <view class="lore-card-head">
        <text class="fc-type">{{item.typeLabel}}</text>
        <text wx:if="{{item.hero}}" class="h-tag">@{{item.hero}}</text>
      </view>
      <view class="lore-term">
        <block wx:if="{{item.termParts}}">
          <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.termParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
        </block>
        <block wx:else>{{item.term}}</block>
      </view>
      <view wx:if="{{item.aliasesText}}" class="lore-alias">又名：{{item.aliasesText}}</view>
      <view class="lore-meaning">
        <block wx:if="{{item.meaningParts}}">
          <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.meaningParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
        </block>
        <block wx:else>{{item.meaning}}</block>
      </view>
      <view wx:if="{{item.example}}" class="lore-example">例：{{item.example}}</view>
      <view wx:if="{{item.detail}}" class="lore-detail">{{item.detail}}</view>
      <view wx:if="{{item.source}}" class="lore-source">{{item.source}}</view>
    </view>
  </view>

  <view wx:elif="{{tab === 'quotes'}}" class="quote-list">
    <view
      class="quote-card"
      wx:for="{{shown}}"
      wx:key="id"
      data-text="{{item.text}} —— {{item.author}}"
      bindlongpress="copyQuote"
    >
      <view class="q-text">
        <block wx:if="{{item.textParts}}">
          <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.textParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
        </block>
        <block wx:else>{{item.text}}</block>
      </view>
      <view class="q-meta">
        <text class="q-author">—— {{item.author}}</text>
        <text wx:if="{{item.src}}" class="q-src">{{item.src}}</text>
      </view>
    </view>
    <view class="longpress-hint">长按名言可复制</view>
  </view>

  <view wx:elif="{{tab === 'heroes'}}" class="hero-list">
    <view
      class="hero-card"
      wx:for="{{shown}}"
      wx:key="id"
      data-id="{{item.id}}"
      hover-class="tap-soft"
      bindtap="openHero"
    >
      <view class="hero-avatar">
        <text class="hero-initial">{{item.initial}}</text>
        <image
          wx:if="{{item.thumb}}"
          class="hero-photo"
          src="{{item.thumb}}"
          mode="aspectFill"
          lazy-load
          data-index="{{index}}"
          binderror="onHeroPhotoError"
        />
      </view>
      <view class="hero-body">
        <view class="hero-name">
          <text class="h-name">
            <block wx:if="{{item.nameParts}}">
              <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.nameParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
            </block>
            <block wx:else>{{item.name}}</block>
          </text>
          <text class="h-rank">{{item.rank}}</text>
        </view>
        <view wx:if="{{item.alias}}" class="hero-alias">又名：{{item.alias}}</view>
        <view class="hero-intro">
          <block wx:if="{{item.introParts}}">
            <text class="{{p.h ? 'hl' : ''}}" wx:for="{{item.introParts}}" wx:for-item="p" wx:key="k">{{p.t}}</text>
          </block>
          <block wx:else>{{item.intro}}</block>
        </view>
        <view wx:if="{{item.tags.length}}" class="hero-tags">
          <text class="h-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
        </view>
        <view class="hero-more">查看详情 →</view>
      </view>
    </view>
  </view>

  <empty-state
    wx:if="{{!shown.length}}"
    title="{{emptyTitle}}"
    sub="{{emptySub}}"
    show-reset="{{keyword}}"
    bindreset="clearSearch"
  />

  <list-foot
    wx:if="{{shown.length}}"
    has-more="{{hasMore}}"
    rest="{{rest}}"
    matched="{{matched}}"
    bindmore="loadMore"
  />
  </block>

  <view class="tip">内容整理自公开语料，仅供娱乐 · 只读浏览</view>
</view>
