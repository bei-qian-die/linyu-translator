@import "styles/theme.wxss";

page {
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Microsoft YaHei", system-ui, sans-serif;
  background: #f7f5f1;
  color: #141414;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border-radius: 0;
  line-height: 1.4;
  font-size: 28rpx;
  color: inherit;
}

button::after {
  border: none;
}

/* 页面壳与主题变量：变量定义在 styles/theme.wxss（C2），这里只做布局 */
.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 44rpx 72rpx;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 自定义导航模式：底部留出自定义 tabBar 高度 + 安全区 */
.page-custom-nav {
  padding-bottom: calc(72rpx + 112rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
  color: var(--muted);
  font-size: 18rpx;
  line-height: 1.5;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.eyebrow-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.eyebrow-mark {
  padding: 0 6rpx;
  color: var(--accent);
}

.eyebrow-arrow {
  padding: 0 8rpx;
  color: var(--accent);
}

.eyebrow-right {
  flex: none;
  color: var(--faint);
  letter-spacing: 0.06em;
}

.page-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.36;
  letter-spacing: 0.005em;
  color: var(--ink);
}

.page-title .pt-line {
  display: block;
}

.pt-dot {
  color: var(--accent);
}

.page-sub {
  margin-top: 14rpx;
  font-size: 18rpx;
  line-height: 1.6;
  letter-spacing: 0.03em;
  color: var(--faint);
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 116rpx;
  border-radius: 28rpx;
  background: var(--cta-bg);
  color: var(--cta-fg);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 3.2rpx;
}

.btn-primary.disabled {
  opacity: 0.4;
}

.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 30rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 18rpx;
  background: transparent;
  color: var(--ink);
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
}

.btn-ghost.danger {
  color: var(--danger);
  border-color: var(--line);
}

.btn-ghost.disabled {
  opacity: 0.35;
}

.search-box {
  display: flex;
  align-items: center;
  height: 84rpx;
  margin-bottom: 20rpx;
  padding: 0;
  border: 0;
  border-bottom: 2rpx solid var(--line-strong);
  border-radius: 0;
  background: transparent;
}

.search-ico {
  position: relative;
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-right: 20rpx;
  border: 3rpx solid var(--faint);
  border-radius: 50%;
}

.search-ico::after {
  content: '';
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 4rpx;
  height: 16rpx;
  border-radius: 2rpx;
  background: var(--faint);
  transform: rotate(-45deg);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 25rpx;
  color: var(--ink);
}

.search-clear {
  flex: none;
  min-width: 56rpx;
  padding: 16rpx 0 16rpx 20rpx;
  color: var(--faint);
  font-size: 22rpx;
  text-align: right;
}

.placeholder {
  color: var(--placeholder);
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: none;
  min-height: 72rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  background: transparent;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1;
}

.chip.on {
  border-color: var(--accent);
  color: var(--accent);
  font-weight: 600;
}

.chip-count {
  margin-left: 8rpx;
  font-size: 18rpx;
  opacity: 0.7;
}

.h-tag {
  display: inline;
  margin: 0 12rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--faint);
  font-size: 18rpx;
  line-height: 1.8;
  letter-spacing: 0.04em;
}

.tip {
  margin: 32rpx 8rpx 0;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.9;
  letter-spacing: 0.04em;
  color: var(--faint);
}

.dot {
  display: inline-block;
  width: 6rpx;
  height: 6rpx;
  margin: 0 10rpx 4rpx 0;
  border-radius: 50%;
  background: var(--accent);
}

.section-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 0 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--ink);
}

.tap-soft {
  background: var(--soft);
}

/* 搜索命中高亮（C6） */
.hl {
  background: var(--soft);
  color: var(--accent);
  border-radius: 4rpx;
}

.word-list,
.rule-list,
.lore-list,
.card-list,
.quote-list,
.hero-list {
  display: flex;
  flex-direction: column;
}

.word-card,
.rule-card,
.lore-card,
.quote-card {
  position: relative;
  margin: 0;
  padding: 26rpx 0;
  border: 0;
  border-bottom: 2rpx solid var(--line);
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.word-main,
.word-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.word-zh {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  word-break: break-all;
}

.word-arrow {
  margin: 0 14rpx;
  font-size: 20rpx;
  color: var(--faint);
}

.word-ly {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--accent);
  word-break: break-all;
}

.word-alias {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--faint);
}

.word-sense {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--muted);
  word-break: break-all;
}

.word-meta {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.word-src {
  font-size: 18rpx;
  line-height: 1.7;
  color: var(--faint);
  word-break: break-all;
}

.rule-head,
.lore-card-head,
.lore-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.rule-id {
  margin-right: 12rpx;
  font-size: 17rpx;
  letter-spacing: 0.04em;
  color: var(--faint);
}

.rule-row {
  display: flex;
  align-items: flex-start;
  margin-top: 8rpx;
}

.rule-label {
  flex: none;
  width: 64rpx;
  margin-right: 16rpx;
  font-size: 18rpx;
  line-height: 1.9;
  color: var(--faint);
}

.rule-label.accent {
  color: var(--accent);
}

.rule-pattern {
  flex: 1;
  min-width: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-family: Consolas, "Courier New", monospace;
  font-size: 21rpx;
  line-height: 1.7;
  word-break: break-all;
}

.rule-template {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.7;
  color: var(--ink);
  word-break: break-all;
}

.rule-example {
  margin-top: 10rpx;
  padding-left: 80rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--muted);
  white-space: pre-wrap;
  word-break: break-all;
}

.lore-card::before {
  display: none;
}

.fc-type {
  display: inline;
  margin-right: 12rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--accent);
  font-size: 18rpx;
  line-height: 1.8;
  letter-spacing: 0.08em;
}

.lore-term {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--accent);
  word-break: break-all;
}

.lore-alias {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--faint);
}

.lore-meaning {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--ink);
  word-break: break-all;
}

.lore-example {
  margin-top: 10rpx;
  padding: 0 0 0 16rpx;
  border-left: 2rpx solid var(--line-strong);
  border-radius: 0;
  background: transparent;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.7;
  word-break: break-all;
}

.lore-detail {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--muted);
  word-break: break-all;
}

.lore-source {
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.7;
  color: var(--faint);
  word-break: break-all;
}

.q-text {
  position: relative;
  padding-top: 0;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.8;
  color: var(--ink);
  word-break: break-all;
}

.q-meta {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}

.q-author {
  font-size: 21rpx;
  color: var(--accent);
}

.q-src {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.7;
  color: var(--faint);
  word-break: break-all;
}

.longpress-hint,
.tap-hint {
  padding: 12rpx 0 8rpx;
  text-align: center;
  font-size: 18rpx;
  line-height: 1.7;
  color: var(--faint);
}

.rise {
  animation: rise 0.24s ease-out both;
}

@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .rise {
    animation: none;
  }
}
